[package]
name = "sd_probe"
version = "0.1.0"
edition = "2021"
publish = false

[dependencies]
revm = { version = "@REVM_REQ@", default-features = false, features = ["std", "serde"] }
revm-inspectors = { path = "@INSP_PATH@", default-features = false, features = ["std", "serde"] }
alloy-rpc-types-trace = { version = "2.0", default-features = false }
alloy-rpc-types-eth = { version = "2.0", default-features = false }
alloy-primitives = { version = "1.4", features = ["serde"] }
serde_json = "1"
